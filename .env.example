# Copy this file to `.env` and fill in your values.
#   cp .env.example .env

# Required. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Only needed for phone control (`python run.py telegram`).
# Create a bot by messaging @BotFather on Telegram; it gives you this token.
TELEGRAM_BOT_TOKEN=

# --- Model backend ---------------------------------------------------------
# "anthropic" (default) = Claude.  "openai" = any OpenAI-compatible server
# (Ollama / vLLM / LM Studio / llama.cpp), i.e. run an open-source model.
# AFB_PROVIDER=anthropic

# Anthropic backend:
# AFB_MODEL=claude-sonnet-4-6

# OpenAI-compatible backend (defaults below target a local Ollama server).
# To use it: set AFB_PROVIDER=openai and (optionally) override these:
# AFB_OPENAI_BASE_URL=http://localhost:11434/v1
# AFB_OPENAI_MODEL=llama3.1
# AFB_OPENAI_API_KEY=ollama        # local servers ignore this; any value works

# AFB_MAX_TOKENS=4096
